#!/bin/bash

set -euo pipefail

# Finds worktrees whose branches are fully merged and cleans each one up by
# delegating to git-cleanup-worktree, so removal, the in-use guard, parent-dir
# pruning and ~/.claude/projects matching all have a single implementation.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
CLEANUP="$SCRIPT_DIR/git-cleanup-worktree"
[ -x "$CLEANUP" ] || { echo "Error: $CLEANUP not found or not executable" >&2; exit 1; }

ASSUME_YES=false
SKIP_GUARD=false
while [ $# -gt 0 ]; do
    case "$1" in
        -y|--yes)   ASSUME_YES=true ;;
        -f|--force) SKIP_GUARD=true ;;
        -h|--help)
            echo "Usage: git cleanup-merged-worktrees [-y|--yes] [-f|--force]"
            echo "  -y, --yes     Skip the confirmation prompt"
            echo "  -f, --force   Clean up even if live processes are using a worktree"
            exit 0 ;;
        *) echo "Unknown argument: $1" >&2; exit 1 ;;
    esac
    shift
done

# Anchor every git call to the repo root instead of the caller's cwd.
MAIN_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" \
    || { echo "Error: not inside a git repository" >&2; exit 1; }
MAIN_ROOT="$(git -C "$MAIN_ROOT" worktree list --porcelain \
    | awk '/^worktree /{print substr($0,10); exit}')"

# `|| true`: with pipefail, a repo without an origin/HEAD would otherwise abort here.
MAIN_BRANCH="$(git -C "$MAIN_ROOT" symbolic-ref refs/remotes/origin/HEAD 2>/dev/null \
    | sed 's@^refs/remotes/origin/@@' || true)"
if [ -z "$MAIN_BRANCH" ]; then
    if git -C "$MAIN_ROOT" show-ref --verify --quiet refs/heads/main; then
        MAIN_BRANCH="main"
    elif git -C "$MAIN_ROOT" show-ref --verify --quiet refs/heads/master; then
        MAIN_BRANCH="master"
    else
        echo "Error: Could not determine main branch" >&2
        exit 1
    fi
fi

echo "Finding merged branches with worktrees..."
echo ""

WORKTREES=()
worktree_path=""
while IFS= read -r line; do
    if [[ "$line" =~ ^worktree ]]; then
        worktree_path="${line#worktree }"
    elif [[ "$line" =~ ^branch ]]; then
        branch="${line#branch refs/heads/}"

        # Never touch the main branch or the main worktree itself.
        [ "$branch" = "$MAIN_BRANCH" ] && continue
        [ "$worktree_path" = "$MAIN_ROOT" ] && continue

        # Skip branches with no commits of their own (no work started).
        ahead="$(git -C "$MAIN_ROOT" rev-list --count "$MAIN_BRANCH".."$branch" 2>/dev/null || echo 0)"
        [ "$ahead" -eq 0 ] && continue

        # Merged when cherry-detection finds nothing unique to the branch — this
        # holds for squash merges, where the branch's own commits never land on main.
        unique="$(git -C "$MAIN_ROOT" log --cherry-mark --right-only --no-merges --oneline \
            "$MAIN_BRANCH...$branch" 2>/dev/null | grep -cv "^=" || true)"
        [ "$unique" -eq 0 ] && WORKTREES+=("$worktree_path|$branch")
    fi
done < <(git -C "$MAIN_ROOT" worktree list --porcelain)

if [ ${#WORKTREES[@]} -eq 0 ]; then
    echo "No merged branches with worktrees found!"
    exit 0
fi

echo "Found ${#WORKTREES[@]} merged worktree(s):"
echo ""
for item in "${WORKTREES[@]}"; do
    echo "Branch: ${item#*|}"
    echo "  Worktree: ${item%|*}"
    echo ""
done

if [ "$ASSUME_YES" != true ]; then
    read -p "Delete all ${#WORKTREES[@]} worktree(s), branches, and Claude projects? (y/N) " -n 1 -r
    echo
    echo ""
    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
        echo "Aborted."
        exit 0
    fi
fi

# Delegate each one. A worktree that is still in use (or otherwise fails) is
# reported as skipped rather than announced as removed — the previous version
# swallowed errors with `|| true`, printed "✓ Removed worktree" regardless, and
# then deleted the Claude session dirs of a checkout that was still there.
CLEANED=0
FAILED=()
FORCE_ARGS=()
[ "$SKIP_GUARD" = true ] && FORCE_ARGS=(--force)
for item in "${WORKTREES[@]}"; do
    worktree_path="${item%|*}"
    branch="${item#*|}"
    echo "Processing: $branch"
    if "$CLEANUP" -y "${FORCE_ARGS[@]+"${FORCE_ARGS[@]}"}" "$worktree_path" 2>&1 | sed 's/^/  /'; then
        CLEANED=$((CLEANED + 1))
    else
        FAILED+=("$branch")
        echo "  ✗ Skipped $branch"
    fi
    echo ""
done

echo "✓ Cleaned up $CLEANED of ${#WORKTREES[@]} merged worktree(s)."
if [ ${#FAILED[@]} -gt 0 ]; then
    echo "Skipped (see output above): ${FAILED[*]}"
    exit 1
fi
